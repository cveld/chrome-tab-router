# Used by `npm run dev:localsync` / `npm run build:localsync`: defaults the sync
# backend to the local relay (/localsync, `npm run localsync:start` from the
# repo root) instead of the cloud. The choice can still be changed on the
# Settings tab. The API urls stay pointed at the Vite dev server so switching
# back to the cloud and generating a group code keeps working.
WXT_DEFAULT_SYNC_BACKEND=local
WXT_API_BASE_URL=http://localhost:4200
WXT_CONFIG_URL=http://localhost:4200
