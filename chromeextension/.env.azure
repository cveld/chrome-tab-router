# Used by `npm run dev:azure` / `npm run build:azure`: the extension against a
# deployed backend instead of localhost. Defaults to production; to test a
# pre-prod or PR staging environment, put its URL in `.env.azure.local`
# (gitignored, overrides this file), e.g.
#   WXT_API_BASE_URL=https://salmon-flower-0b5657e03-<n>.westeurope.azurestaticapps.net
#   WXT_CONFIG_URL=https://salmon-flower-0b5657e03-<n>.westeurope.azurestaticapps.net
WXT_API_BASE_URL=https://chrome-tab-router.carlintveld.nl
WXT_CONFIG_URL=https://chrome-tab-router.carlintveld.nl
