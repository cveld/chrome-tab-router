{
  "name": "chrome-tab-router-extension",
  "version": "0.6.0",
  "description": "Routes urls to desired user profiles",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:azure": "wxt -m azure",
    "dev:localfunc": "wxt -m localfunc",
    "build": "wxt build",
    "build:azure": "wxt build -m azure",
    "build:localfunc": "wxt build -m localfunc",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "style": "prettier --write \"src/**/*.{ts,tsx}\" \"entrypoints/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "axios": "^1.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
