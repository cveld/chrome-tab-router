{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    // .wxt/tsconfig.json (generated by `wxt prepare`) does not set this, so
    // plain `tsc --noEmit` fails on every .tsx file without it. Vite/esbuild
    // don't need it, but editor tooling and CI typechecks do.
    "jsx": "react-jsx"
  }
}
