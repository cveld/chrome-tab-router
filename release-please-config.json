{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "packages": {
    "app": {
      "release-type": "node",
      "component": "webapp-app",
      "changelog-path": "CHANGELOG.md"
    },
    "api": {
      "release-type": "node",
      "component": "webapp-api",
      "changelog-path": "CHANGELOG.md"
    },
    "chromeextension": {
      "release-type": "node",
      "component": "extension",
      "changelog-path": "CHANGELOG.md"
    },
    "localsync": {
      "release-type": "node",
      "component": "localsync",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "webapp",
      "components": [
        "webapp-app",
        "webapp-api"
      ]
    }
  ]
}
